# REVIEWED-BUT-UNVERIFIED, PRODUCTION-TARGET, ILLUSTRATIVE — see
# deploy/systemd/README.md.
[Unit]
Description=ADAS AI engine
After=network-online.target adas-restore-coordinator.service adas-backend.service
Wants=network-online.target
Requires=adas-backend.service

# Run `uv run python ai_engine/capacity.py` ONCE on this host before enabling
# the unit. It writes ai_engine/machine_profile.json, which is machine-specific
# and gitignored, so it never arrives with a deploy. Without it the engine does
# not fail — it falls back to a capacity of ONE camera and says so in its
# startup log. On the 8x L4 target that is a silent, very large
# under-utilisation, and the only symptom is a line nobody reads.
[Service]
Type=simple
User=adas
Group=adas
WorkingDirectory=/opt/adas-capstone
ExecStart=/usr/local/bin/uv run python ai_engine/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# REVIEWED-BUT-UNVERIFIED, PRODUCTION-TARGET, ILLUSTRATIVE — see
# deploy/systemd/README.md.
[Unit]
Description=ADAS FastAPI backend
After=network-online.target adas-restore-coordinator.service
Wants=network-online.target adas-restore-coordinator.service

[Service]
Type=simple
User=adas
Group=adas
WorkingDirectory=/opt/adas-capstone
ExecStart=/usr/local/bin/uv run fastapi run backend/app/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

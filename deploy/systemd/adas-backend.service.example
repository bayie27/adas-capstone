# REVIEWED-BUT-UNVERIFIED, PRODUCTION-TARGET, ILLUSTRATIVE — see
# deploy/systemd/README.md. Not part of P7's scope; copy and adapt.
[Unit]
Description=ADAS FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adas
Group=adas
WorkingDirectory=/opt/adas-capstone
ExecStart=/usr/local/bin/uv run fastapi run backend/app/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

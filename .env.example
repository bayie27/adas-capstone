# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false

# Security
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
JWT_ISSUER=adas-backend
JWT_AUDIENCE=adas-dashboard

# Sessions
SESSION_LIFETIME_MINUTES=480
SESSION_COOKIE_NAME=adas_session
SESSION_COOKIE_SECURE=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# AI Internal Webhook
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite:///./adas.db
# Operator changes this on first login
DEFAULT_ADMIN_PASSWORD=change-me
SQLITE_BUSY_TIMEOUT_MS=5000

# Scheduler
SCHEDULER_ENABLED=true

# Storage roots
SNAPSHOT_ROOT=ai_engine/snapshots
LEGACY_SNAPSHOT_DIR=ai_engine/snapshots
BACKUP_DIR=var/backups
EXPORT_DIR=var/exports
ARCHIVE_DIR=var/archive

# RTSP construction — demo default targets MediaMTX
RTSP_URL_TEMPLATE=rtsp://localhost:8554/channel{channel_id}

# Dahua DSS Pro VMS Gateway Credentials — optional, only consumed if
# RTSP_URL_TEMPLATE references them (production template). Leave unset for
# the MediaMTX demo template above; uncomment and fill in for production.
#DSS_IP=10.0.5.50
#DSS_PORT=554
#DSS_USERNAME=your-vms-username
#DSS_PASS=your-vms-password

# Alarm settings
ALARM_SOUND_KEYS=default
SNOOZE_MIN_SECONDS=15
SNOOZE_MAX_SECONDS=60
DISMISS_COOLDOWN_SECONDS=60

# Heartbeat / health
HEARTBEAT_STALE_SECONDS=10
HEALTH_SAMPLE_SECONDS=5
HEALTH_PERSIST_SECONDS=300
HEALTH_RAW_RETENTION_HOURS=48
HEALTH_HOURLY_RETENTION_DAYS=30
GPU_TEMP_CRITICAL_C=85
RAM_CRITICAL_PCT=95
DISK_WARNING_PCT=80
DISK_CRITICAL_PCT=90

# Exports
EXPORT_PDF_MAX_ROWS=10000
EXPORT_CSV_MAX_ROWS=50000
EXPORT_ARTIFACT_TTL_HOURS=72
# One bounded local worker on the demo profile; no Celery/Redis/broker.
EXPORT_JOB_WORKERS=1
# IANA zone name for the local-display timestamp every PDF report shows
# alongside its UTC generation time.
REPORT_LOCAL_TIMEZONE=Asia/Manila

# WebSocket
WS_MAX_CONNECTIONS_TOTAL=50
WS_MAX_CONNECTIONS_PER_USER=5
WS_QUEUE_MAXSIZE=100
WS_SEND_TIMEOUT_SECONDS=5

# Backups
BACKUP_DAILY_RETENTION=30
BACKUP_MANUAL_RETENTION=10

# Maintenance
MAINTENANCE_HOUR_LOCAL=3

# --- LAN demo profile (be_audit/A1_lan_tls_drill.md) ---
# Two laptops on a direct Ethernet cable, static IPs, real self-signed TLS.
# Uncomment this block instead of the defaults above when running the wired-LAN demo.
# The cert is issued to the hostname `adas.local` (see A1 step 1), never to a bare IP,
# so a client-side hosts-file entry (`192.168.50.1  adas.local`) is required.
#SESSION_COOKIE_SECURE=true
#CORS_ORIGINS=https://adas.local:5173,https://localhost:5173
# Frontend-only: set when running `pnpm dev` on the server laptop so vite.config.ts
# picks up the same cert/key pair uvicorn is started with (see A1 step 2-3).
#ADAS_TLS_CERT_DIR=certs

# --- Dev tools (dev_plan/02_PKG_dev_api.md, DT-3) -----------------------------
# Enables the in-app dev panel and the /api/dev/* routes. Left commented so CI,
# which does cp .env.example .env, keeps the development-derived default
# (on in development, off in production).
#
# Set it true on the LAN demo box: the panel has to work there even though it
# serves a production build. The routes are admin-gated and login-as requires an
# existing session precisely because this flag can be on outside development.
#DEV_TOOLS_ENABLED=true
